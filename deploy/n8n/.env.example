N8N_IMAGE=n8nio/n8n:2.42.6
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Guayaquil
GENERIC_TIMEZONE=America/Guayaquil

# OpenJarvis runs on the Windows host while n8n runs in Docker.
OPENJARVIS_BASE_URL=http://host.docker.internal:8000

# Set when OpenJarvis API authentication is enabled.
OPENJARVIS_API_KEY=

# Jarvis workflow expressions use $env for local OpenJarvis endpoints.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
